function ScannerPage({ products }) {
  const [input, setInput] = useState("");
  const [result, setResult] = useState(null);
  const [notFound, setNotFound] = useState(false);
  const [showQR, setShowQR] = useState(null);
  const canvasRef = useRef(null);

  useEffect(() => {
    if (showQR && canvasRef.current) drawQR(canvasRef.current, showQR.sku, 200);
  }, [showQR]);

  const scan = (val) => {
    const q = (val || input).trim().toLowerCase();
    if (!q) return;
    const found = products.find(p => p.sku.toLowerCase() === q || p.id.toLowerCase() === q || p.name.toLowerCase().includes(q));
    if (found) { setResult(found); setNotFound(false); }
    else { setResult(null); setNotFound(true); }
  };

