        </style>
      </head>
      <body>
        <div class="container">
          <canvas id="qrCanvas"></canvas>
          <h2>${prod.name}</h2>
          <p>SKU: ${prod.sku} | ID: ${prod.id}</p>
        </div>
        <script>
          const canvas = document.getElementById("qrCanvas");
          const drawQR = ${drawQR.toString()};
          drawQR(canvas, "${prod.sku}", 250);
          window.onload = function() { window.print(); window.close(); }
        </script>
      </body>
      </html>
