}

function AnalyticsPage({ products, store, categories }) {
  const totalVal = products.reduce((s, p) => s + p.stock * p.price, 0);
  const emptyStock = products.filter(p => p.stock === 0);
  
  const catData = categories.map(cat => ({
    name: cat.name.slice(0, 6),
    fullName: cat.name,
    color: cat.color,
    items: products.filter(p => p.category === cat.name).reduce((s, p) => s + p.stock, 0),
    value: products.filter(p => p.category === cat.name).reduce((s, p) => s + p.stock * p.price, 0),
  })).filter(c => c.items > 0);

  const stockData = products.map(p => ({
    name: p.name.split(" ").slice(0, 2).join(" "),
    stock: p.stock,
  }));

  return (
    <div style={{ padding: "16px 0" }}>
      <div style={{ marginBottom: 22 }}>
        <h2 style={{ margin: 0, fontSize: 20, fontWeight: 800, color: "#1e293b" }}>Analitik Stor</h2>
        <p style={{ margin: "4px 0 0", fontSize: 14, color: "#94a3b8" }}>{store?.name}</p>
      </div>
      <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(290px, 1fr))", gap: 16 }}>
        
        {/* Carta hanya memaparkan aras baki stok fizikal semasa */}
        <div style={{ background: "#fff", borderRadius: 16, padding: "20px 18px", boxShadow: "0 2px 10px rgba(0,0,0,0.06)", gridColumn: "1 / -1" }}>
          <div style={{ fontWeight: 700, fontSize: 14, color: "#1e293b", marginBottom: 4 }}>Aras Baki Stok Semasa</div>
          <div style={{ fontSize: 12, color: "#94a3b8", marginBottom: 16 }}>Aras kuantiti semasa setiap SKU di dalam stor</div>
          <ResponsiveContainer width="100%" height={180}>
            <BarChart data={stockData} margin={{ left: -20, right: 8 }}>
              <XAxis dataKey="name" tick={{ fontSize: 10, fill: "#94a3b8" }} />
              <YAxis tick={{ fontSize: 10, fill: "#94a3b8" }} />
              <Tooltip contentStyle={{ borderRadius: 10, fontSize: 12 }} />
              <Bar dataKey="stock" radius={[4,4,0,0]} name="Stok Semasa">
                {stockData.map((e, i) => <Cell key={i} fill={e.stock === 0 ? "#ef4444" : "#6366f1"} />)}
              </Bar>
            </BarChart>
          </ResponsiveContainer>
        </div>

        <div style={{ background: "#fff", borderRadius: 16, padding: "20px 18px", boxShadow: "0 2px 10px rgba(0,0,0,0.06)" }}>
          <div style={{ fontWeight: 700, fontSize: 14, color: "#1e293b", marginBottom: 14 }}>Nilai Kategori</div>
          {catData.sort((a,b) => b.value-a.value).map(c => (
            <div key={c.name} style={{ marginBottom: 10 }}>
              <div style={{ display: "flex", justifycontent: "space-between", marginBottom: 4 }}>
                <span style={{ fontSize: 13, color: "#374151", fontWeight: 600 }}>{c.fullName}</span>
                <span style={{ fontSize: 13, color: "#6366f1", fontWeight: 700 }}>${c.value.toFixed(2)}</span>
              </div>
              <div style={{ height: 7, background: "#f1f5f9", borderRadius: 99 }}>
                <div style={{ height: 7, width: `${totalVal > 0 ? (c.value/totalVal)*100 : 0}%`, background: c.color, borderRadius: 99 }} />
              </div>
            </div>
          ))}
        </div>

        {/* Seksyen Amaran Barangan Habis Stok (Tindakan segera pengganti Tahap Keselamatan) */}
        <div style={{ background: "#fff", borderRadius: 16, padding: "20px 18px", boxShadow: "0 2px 10px rgba(0,0,0,0.06)" }}>
          <div style={{ fontWeight: 700, fontSize: 14, color: "#1e293b", marginBottom: 14 }}>❌ Barangan Habis Stok</div>
          {emptyStock.length === 0
            ? <div style={{ color: "#16a34a", fontWeight: 600, fontSize: 14, padding: "20px 0", textAlign: "center" }}>Semua Stok Tersedia ✓</div>
            : emptyStock.map(p => (
              <div key={p.id} style={{ display: "flex", justifycontent: "space-between", alignItems: "center", padding: "10px 0", borderBottom: "1px solid #f8fafc" }}>
                <div>
                  <div style={{ fontWeight: 700, fontSize: 13, color: "#1e293b" }}>{p.name}</div>
                  <div style={{ fontSize: 11, color: "#94a3b8" }}>{p.sku}</div>
                </div>
                <div style={{ textAlign: "right" }}>
                  <div style={{ fontWeight: 800, color: "#dc2626", fontSize: 16 }}>0</div>
                  <div style={{ fontSize: 11, color: "#94a3b8" }}>{p.unit}</div>
                </div>
              </div>
            ))}
        </div>

      </div>
    </div>
  );
}

function HomePage({ onEnter }) {
  const [form, setForm] = useState({ name: "", username: "", password: "" });
  const [errors, setErrors] = useState({});
  const [tab, setTab] = useState("login");
  const [success, setSuccess] = useState("");
  const [registered, setRegistered] = useState([
    { username: "admin", password: "admin123", name: "Admin Utama" }
  ]);

  const validateRegister = () => {
    const e = {};
    if (!form.name.trim()) e.name = "Nama diperlukan";
    if (!form.username.trim()) e.username = "Username diperlukan";
    else if (registered.find(u => u.username === form.username)) e.username = "Username wujud";
    if (!form.password || form.password.length < 6) e.password = "Kata laluan min 6 aksara";
    return e;
  };

  const handleRegister = () => {
    const e = validateRegister();
    if (Object.keys(e).length) { setErrors(e); return; }
    setRegistered(prev => [...prev, { username: form.username, password: form.password, name: form.name }]);
    setSuccess("Akaun berjaya dicipta! Sila log masuk.");
    setForm({ name: "", username: "", password: "" });
    setErrors({});
    setTimeout(() => { setSuccess(""); setTab("login"); }, 1800);
  };

  const handleLogin = () => {
    const e = {};
    if (!form.username.trim()) e.username = "Username diperlukan";
    if (!form.password) e.password = "Kata laluan diperlukan";
    if (Object.keys(e).length) { setErrors(e); return; }
    const user = registered.find(u => u.username === form.username && u.password === form.password);
    if (!user) { setErrors({ password: "Username atau kata laluan salah" }); return; }
    onEnter(user.name, form.password);
  };

  return (
    <div style={{ minHeight: "100vh", background: "linear-gradient(135deg, #1e293b 0%, #312e81 50%, #1e293b 100%)", display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", padding: 20, fontFamily: "'Inter', system-ui, sans-serif" }}>
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        input:focus { border-color: #6366f1 !important; box-shadow: 0 0 0 3px rgba(99,102,241,0.18); outline: none; }
      `}</style>

      <div style={{ textAlign: "center", marginBottom: 36 }}>
        <div style={{ width: 64, height: 64, background: "linear-gradient(135deg,#6366f1,#8b5cf6)", borderRadius: 20, display: "flex", alignItems: "center", justifyContent: "center", fontSize: 32, margin: "0 auto 14px", boxShadow: "0 8px 32px rgba(99,102,241,0.4)" }}>▦</div>
        <h1 style={{ color: "#fff", fontSize: 30, fontWeight: 900, letterSpacing: -0.5 }}>StockPilot</h1>
        <p style={{ color: "rgba(255,255,255,0.55)", fontSize: 15, marginTop: 6 }}>Sistem Kad Stok & Kawalan Inventori</p>
      </div>

      <div style={{ background: "#fff", borderRadius: 24, padding: "30px 28px", width: "100%", maxWidth: 400, boxShadow: "0 32px 80px rgba(0,0,0,0.4)" }}>
        <div style={{ display: "flex", background: "#f1f5f9", borderRadius: 12, padding: 4, marginBottom: 24 }}>
          {[["login","Log Masuk"],["register","Daftar"]].map(([t, label]) => (
            <button key={t} onClick={() => { setTab(t); setForm({ name:"",username:"",password:"" }); setErrors({}); setSuccess(""); }}
              style={{ flex: 1, padding: "9px 0", borderRadius: 9, border: "none", cursor: "pointer", fontWeight: 700, fontSize: 14, transition: "all 0.18s",
                background: tab === t ? "#fff" : "transparent",
                color: tab === t ? "#6366f1" : "#94a3b8",
                boxShadow: tab === t ? "0 2px 8px rgba(0,0,0,0.08)" : "none" }}>{label}</button>
          ))}
        </div>

        {success && <div style={{ marginBottom: 16, padding: "10px 14px", background: "#dcfce7", color: "#16a34a", borderRadius: 10, fontSize: 13, fontWeight: 600 }}>✓ {success}</div>}

        <div style={{ display: "flex", flexDirection: "column", gap: 14 }}>
          {tab === "register" && (
            <div>
              <label style={{ fontSize: 12, color: "#64748b", fontWeight: 600, display: "block", marginBottom: 5 }}>Nama Penuh</label>
              <input value={form.name} placeholder="Ahmad Razif"
                onChange={e => { setForm(f => ({...f, name: e.target.value})); setErrors(x => ({...x, name:""})); }}
                style={{ width: "100%", padding: "11px 14px", border: `2px solid ${errors.name ? "#fca5a5" : "#e2e8f0"}`, borderRadius: 10, fontSize: 14 }} />
              {errors.name && <div style={{ fontSize: 11, color: "#dc2626", marginTop: 3 }}>{errors.name}</div>}
            </div>
          )}
          <div>
            <label style={{ fontSize: 12, color: "#64748b", fontWeight: 600, display: "block", marginBottom: 5 }}>Username</label>
            <input value={form.username} placeholder="username"
              onChange={e => { setForm(f => ({...f, username: e.target.value})); setErrors(x => ({...x, username:""})); }}
              style={{ width: "100%", padding: "11px 14px", border: `2px solid ${errors.username ? "#fca5a5" : "#e2e8f0"}`, borderRadius: 10, fontSize: 14 }} />
            {errors.username && <div style={{ fontSize: 11, color: "#dc2626", marginTop: 3 }}>{errors.username}</div>}
          </div>
          <div>
            <label style={{ fontSize: 12, color: "#64748b", fontWeight: 600, display: "block", marginBottom: 5 }}>Kata Laluan</label>
            <input type="password" value={form.password} placeholder="••••••••"
              onChange={e => { setForm(f => ({...f, password: e.target.value})); setErrors(x => ({...x, password:""})); }}
              onKeyDown={e => e.key === "Enter" && (tab === "login" ? handleLogin() : handleRegister())}
              style={{ width: "100%", padding: "11px 14px", border: `2px solid ${errors.password ? "#fca5a5" : "#e2e8f0"}`, borderRadius: 10, fontSize: 14 }} />
            {errors.password && <div style={{ fontSize: 11, color: "#dc2626", marginTop: 3 }}>{errors.password}</div>}
          </div>
          <button onClick={tab === "login" ? handleLogin : handleRegister}
            style={{ width: "100%", padding: "13px", background: "linear-gradient(135deg,#6366f1,#8b5cf6)", color: "#fff", border: "none", borderRadius: 12, cursor: "pointer", fontWeight: 800, fontSize: 15, marginTop: 4, boxShadow: "0 4px 16px rgba(99,102,241,0.35)" }}>
            {tab === "login" ? "Log Masuk →" : "Daftar Akaun →"}
          </button>
        </div>

        {tab === "login" && (
          <div style={{ marginTop: 16, padding: "10px 14px", background: "#f8fafc", borderRadius: 10, fontSize: 12, color: "#94a3b8", textAlign: "center" }}>
            Akaun Demo: username <strong style={{ color: "#6366f1" }}>admin</strong> · laluan <strong style={{ color: "#6366f1" }}>admin123</strong>
          </div>
        )}
      </div>

      <p style={{ color: "rgba(255,255,255,0.3)", fontSize: 12, marginTop: 24 }}>© 2026 StockPilot · v2.0</p>
    </div>
  );
}

export default function App() {
  const [loggedIn, setLoggedIn] = useState(false);
  const [userName, setUserName] = useState("");
  const [loginPassword, setLoginPassword] = useState("");
  const [page, setPage] = useState("stores");
  const [store, setStore] = useState(null);
  const [stores, setStores] = useState(INITIAL_STORES);
  const [allProducts, setAllProducts] = useState(SEED_PRODUCTS);
  const [categories, setCategories] = useState(DEFAULT_CATEGORIES);
  const [onlineCount, setOnlineCount] = useState(1);

  useEffect(() => {
    const base = Math.floor(Math.random() * 4) + 2;
    setOnlineCount(base);
    const interval = setInterval(() => {
      setOnlineCount(prev => {
        const delta = Math.random() < 0.3 ? (Math.random() < 0.5 ? 1 : -1) : 0;
        return Math.max(1, Math.min(12, prev + delta));
      });
    }, 8000);
    return () => clearInterval(interval);
  }, []);

  if (!loggedIn) return <HomePage onEnter={(name, pw) => { setLoggedIn(true); setUserName(name); setLoginPassword(pw); }} />;

  const handleAddStore = (newStore) => {
    setStores(prev => [...prev, newStore]);
    setAllProducts(prev => ({ ...prev, [newStore.id]: [] }));
  };

  const handleDeleteStore = (storeId) => {
    setStores(prev => prev.filter(s => s.id !== storeId));
    setAllProducts(prev => { const next = { ...prev }; delete next[storeId]; return next; });
    if (store?.id === storeId) { setStore(null); setPage("stores"); }
  };

  const products = store ? (allProducts[store.id] || []) : [];
  const setProducts = (fn) => {
    if (!store) return;
    setAllProducts(prev => ({ ...prev, [store.id]: typeof fn === "function" ? fn(prev[store.id] || []) : fn }));
  };

  // Status amaran dikesan daripada jumlah barangan habis baki stok (stock === 0)
  const emptyStockCount = products.filter(p => p.stock === 0).length;

  const nav = [
    { id: "stores", icon: "🏢", label: "Stor" },
    { id: "inventory", icon: "📦", label: "Stok" },
    { id: "scanner", icon: "⊞", label: "Scan & QR" },
    { id: "analytics", icon: "📊", label: "Analitik" },
    { id: "users", icon: "👥", label: "Kakitangan" },
  ];

  const goTo = (p) => {
    if (p !== "stores" && p !== "users" && !store) { setPage("stores"); return; }
    setPage(p);
  };

  return (
    <div style={{ minHeight: "100vh", background: "#f1f5f9", fontFamily: "'Inter', system-ui, sans-serif", display: "flex", flexDirection: "column" }}>
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body { -webkit-font-smoothing: antialiased; }
        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
        @keyframes scanline { 0%,100%{top:4px}50%{top:calc(100% - 6px)} }
        @keyframes fadeIn { from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none} }
        .inv-row { animation: fadeIn 0.2s ease; }
        input:focus, select:focus { border-color: #6366f1 !important; box-shadow: 0 0 0 3px rgba(99,102,241,0.12); }
        
        /* CSS KHAS: Mematikan butang anak panah spin (spinners) pada sebarang input nombor asli secara global */
        input::-webkit-outer-spin-button,
        input::-webkit-inner-spin-button {
          -webkit-appearance: none;
          margin: 0;
        }
        input[type=number] {
          -moz-appearance: textfield;
        }

        @media (max-width: 600px) {
          .sp-header-title { display: none; }
          .sp-store-chip { max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        }
      `}</style>

      <div style={{ background: "#fff", borderBottom: "1px solid #e2e8f0", padding: "0 16px", position: "sticky", top: 0, zIndex: 50 }}>
        <div style={{ maxWidth: 960, margin: "0 auto", height: 56, display: "flex", alignItems: "center", justifyContent: "space-between", gap: 12 }}>
          <div style={{ display: "flex", alignItems: "center", gap: 10, flexShrink: 0 }}>
            <div style={{ width: 30, height: 30, background: "linear-gradient(135deg,#6366f1,#8b5cf6)", borderRadius: 8, display: "flex", alignItems: "center", justifyContent: "center", color: "#fff", fontSize: 15, fontWeight: 900 }}>▦</div>
            <span className="sp-header-title" style={{ fontWeight: 800, fontSize: 16, color: "#1e293b" }}>StockPilot</span>
