          {page === "analytics" && store && <AnalyticsPage products={products} store={store} categories={categories} />}
          {page === "analytics" && !store && <div style={{ padding: "60px 0", textAlign: "center", color: "#94a3b8" }}>Sila pilih stor terlebih dahulu.</div>}
          {page === "users" && <UsersPage stores={stores} onlineCount={onlineCount} />}
        </div>
      </div>

      <div style={{ position: "fixed", bottom: 0, left: 0, right: 0, background: "#fff", borderTop: "1px solid #e2e8f0", zIndex: 50, paddingBottom: "env(safe-area-inset-bottom, 0px)" }}>
        <div style={{ maxWidth: 960, margin: "0 auto", display: "flex", justifyContent: "space-around" }}>
          {nav.map(n => {
            const active = page === n.id;
            const needStore = n.id !== "stores" && n.id !== "users" && !store;
            return (
              <button key={n.id} onClick={() => goTo(n.id)}
                style={{ flex: 1, padding: "10px 4px 8px", background: "none", border: "none", cursor: "pointer", display: "flex", flexDirection: "column", alignItems: "center", gap: 3, opacity: needStore ? 0.4 : 1 }}>
                <span style={{ fontSize: 20 }}>{n.icon}</span>
                <span style={{ fontSize: 10, fontWeight: active ? 800 : 600, color: active ? "#6366f1" : "#94a3b8" }}>{n.label}</span>
                {active && <div style={{ width: 4, height: 4, borderRadius: "50%", background: "#6366f1" }} />}
              </button>
            );
          })}
        </div>
      </div>
    </div>
  );
}
