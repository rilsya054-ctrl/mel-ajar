function InventoryPage({ products, setProducts, store, categories, setCategories, userName }) {
  const [search, setSearch] = useState("");
  const [filterCat, setFilterCat] = useState("All");
  const [editItem, setEditItem] = useState(null);
  const [showAdd, setShowAdd] = useState(false);
  const [showAI, setShowAI] = useState(false);
  const [showCatMgr, setShowCatMgr] = useState(false);
  const [aiText, setAiText] = useState(""); const [aiLoading, setAiLoading] = useState(false);
  const [toast, setToast] = useState("");
  
  // State baharu barangan (minStock telah dibuang sepenuhnya, harga & stok disimpan sebagai rentetan teks kosong pada permulaan)
  const [newP, setNewP] = useState({ name: "", sku: "", category: categories[0]?.name || "", stock: "", price: "", unit: "pcs" });
  const [newCatName, setNewCatName] = useState("");
  const [newCatColor, setNewCatColor] = useState(PALETTE[0]);
  const [catError, setCatError] = useState("");
  const qrRef = useRef(null);
  const [qrItem, setQrItem] = useState(null);

  const [activeStockCard, setActiveStockCard] = useState(null);
  const [manualLogType, setManualLogType] = useState("MASUK");
  const [manualLogQty, setManualLogQty] = useState("");
  const [manualLogRemark, setManualLogRemark] = useState("");

  useEffect(() => { if (qrItem && qrRef.current) drawQR(qrRef.current, qrItem.sku, 180); }, [qrItem]);

  useEffect(() => {
    if (filterCat !== "All" && !categories.find(c => c.name === filterCat)) setFilterCat("All");
  }, [categories]);

  const filtered = products.filter(p =>
    (filterCat === "All" || p.category === filterCat) &&
    (p.name.toLowerCase().includes(search.toLowerCase()) || p.sku.toLowerCase().includes(search.toLowerCase()))
  );

  const callAI = () => {
    setShowAI(true); setAiLoading(true); setAiText("");
    const emptyStock = products.filter(p => p.stock === 0);
    const totalVal = products.reduce((s, p) => s + p.stock * p.price, 0);
    setTimeout(() => {
      setAiText(`• Penyelarasan Baki: Terdapat ${emptyStock.length} barangan yang telah habis baki stoknya.\n• Cadangan: Rekodkan transaksi terima stok baharu segera.\n• Analitik Stor: Stok semasa bernilai $${totalVal.toFixed(2)} secara keseluruhan.`);
      setAiLoading(false);
    }, 1200);
  };

  const addProduct = () => {
    if (!newP.name || !newP.sku) return;
    const parsedPrice = parseFloat(newP.price) || 0;
    const parsedStock = parseInt(newP.stock) || 0;
    const initialHist = [{
      date: new Date().toISOString().split("T")[0],
      type: "INIT",
      qty: parsedStock,
      balance: parsedStock,
      remark: "Pendaftaran produk baru",
      user: userName
    }];
    setProducts(prev => [...prev, { 
      ...newP, 
      price: parsedPrice, 
      stock: parsedStock, 
      id: "P" + uid(), 
      history: initialHist, 
      lastUpdated: new Date().toISOString().split("T")[0] 
    }]);
    setNewP({ name: "", sku: "", category: categories[0]?.name || "", stock: "", price: "", unit: "pcs" });
    setShowAdd(false); setToast("Barangan ditambah");
  };

  const saveEdit = (p) => { 
    const parsedPrice = parseFloat(p.price) || 0;
    const parsedStock = parseInt(p.stock) || 0;
    setProducts(prev => prev.map(x => {
      if (x.id === p.id) {
        const diff = parsedStock - x.stock;
        let nextHist = x.history ? [...x.history] : [];
        if (diff !== 0) {
          nextHist.push({
            date: new Date().toISOString().split("T")[0],
            type: diff > 0 ? "MASUK" : "KELUAR",
            qty: Math.abs(diff),
            balance: parsedStock,
            remark: "Penyelarasan stok melalui penyuntingan profil",
            user: userName
          });
        }
        return { ...p, price: parsedPrice, stock: parsedStock, history: nextHist, lastUpdated: new Date().toISOString().split("T")[0] };
      }
      return x;
    })); 
    setEditItem(null); 
    setToast("Kemaskinian disimpan"); 
  };

  const addCategory = () => {
    const trimmed = newCatName.trim();
    if (!trimmed) { setCatError("Nama diperlukan"); return; }
    if (categories.find(c => c.name.toLowerCase() === trimmed.toLowerCase())) { setCatError("Kategori wujud"); return; }
    setCategories(prev => [...prev, { name: trimmed, color: newCatColor }]);
    setNewCatName(""); setCatError(""); setToast("Kategori ditambah");
  };

  const removeCategory = (name) => {
    const inUse = products.some(p => p.category === name);
    if (inUse) { setToast(`"${name}" sedang digunakan oleh barangan — sila tukar dahulu`); return; }
    setCategories(prev => prev.filter(c => c.name !== name));
    setToast("Kategori dibuang");
  };

  const updateCatColor = (name, color) => {
    setCategories(prev => prev.map(c => c.name === name ? { ...c, color } : c));
  };

  const adjustStock = (product, change) => {
    const newStock = product.stock + change;
    if (newStock < 0) return;
    
    const newLog = {
      date: new Date().toISOString().split("T")[0],
      type: change > 0 ? "MASUK" : "KELUAR",
      qty: Math.abs(change),
      balance: newStock,
      remark: change > 0 ? `Stok ditambah oleh ${userName}` : `Stok dikurangkan oleh ${userName}`,
      user: userName
    };

    setProducts(prev => prev.map(x => {
      if (x.id === product.id) {
        const currentHist = x.history || [
          { date: x.lastUpdated, type: "INIT", qty: x.stock, balance: x.stock, remark: "Baki stok asal", user: "Sistem" }
        ];
        return {
          ...x,
          stock: newStock,
          history: [...currentHist, newLog],
          lastUpdated: new Date().toISOString().split("T")[0]
        };
      }
      return x;
    }));
    setToast(`${product.name}: stok dilaraskan kepada ${newStock}`);
  };

  const handleAddManualMovement = () => {
    const qty = parseInt(manualLogQty);
    if (isNaN(qty) || qty <= 0) { setToast("Kuantiti tidak sah"); return; }
    if (!manualLogRemark.trim()) { setToast("Sila masukkan catatan ringkas"); return; }

    const change = manualLogType === "MASUK" ? qty : -qty;
    const newStock = activeStockCard.stock + change;
    if (newStock < 0) { setToast("Had stok negatif tidak dibenarkan"); return; }

    const newLog = {
      date: new Date().toISOString().split("T")[0],
      type: manualLogType,
      qty: qty,
      balance: newStock,
      remark: manualLogRemark.trim(),
      user: userName
    };

    setProducts(prev => prev.map(x => {
      if (x.id === activeStockCard.id) {
        const currentHist = x.history || [
          { date: x.lastUpdated, type: "INIT", qty: x.stock, balance: x.stock, remark: "Baki stok asal", user: "Sistem" }
        ];
        const updatedItem = {
          ...x,
          stock: newStock,
          history: [...currentHist, newLog],
          lastUpdated: new Date().toISOString().split("T")[0]
        };
        setActiveStockCard(updatedItem);
        return updatedItem;
      }
      return x;
    }));

    setManualLogQty("");
    setManualLogRemark("");
    setToast("Pergerakan stok direkodkan!");
  };

  const handleExportCSV = (prod) => {
    const hist = prod.history || [{ date: prod.lastUpdated, type: "INIT", qty: prod.stock, balance: prod.stock, remark: "Baki stok semasa", user: "Sistem" }];
    let csvContent = "Tarikh,Jenis Transaksi,Kuantiti,Baki Stok,Catatan,Oleh\n";
    
    hist.forEach(h => {
      const row = [
        `"${h.date}"`,
        `"${h.type}"`,
        `"${h.qty}"`,
        `"${h.balance}"`,
        `"${(h.remark || "").replace(/"/g, '""')}"`,
        `"${h.user || "Staf"}"`
      ].join(",");
      csvContent += row + "\n";
    });

    const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.setAttribute("href", url);
    link.setAttribute("download", `Kad_Stok_${prod.sku}_${prod.name.replace(/\s+/g, "_")}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    setToast("Fail CSV dimuat turun");
  };

  const handleCopyClipboard = (prod) => {
    const hist = prod.history || [{ date: prod.lastUpdated, type: "INIT", qty: prod.stock, balance: prod.stock, remark: "Baki stok semasa", user: "Sistem" }];
    let text = `KAD STOK - ${prod.name} (${prod.sku})\n`;
    text += `Tarikh\tJenis\tKuantiti\tBaki\tCatatan\tDiurus Oleh\n`;
    
    hist.forEach(h => {
      text += `${h.date}\t${h.type}\t${h.qty}\t${h.balance}\t${h.remark || ""}\t${h.user || "Staf"}\n`;
    });

    const textarea = document.createElement("textarea");
    textarea.value = text;
    textarea.style.position = "fixed";
    document.body.appendChild(textarea);
    textarea.select();
    try {
      document.execCommand("copy");
      setToast("Data disalin ke papan klip!");
    } catch (e) {
      setToast("Gagal menyalin data");
    }
    document.body.removeChild(textarea);
  };

  const handlePrintPDF = (prod) => {
    const printWindow = window.open("", "_blank");
    const hist = prod.history || [{ date: prod.lastUpdated, type: "INIT", qty: prod.stock, balance: prod.stock, remark: "Baki stok semasa", user: "Sistem" }];
    
    let tableRows = "";
    hist.forEach(h => {
      tableRows += `
        <tr>
          <td>${h.date}</td>
          <td><span class="badge ${h.type.toLowerCase()}">${h.type}</span></td>
          <td style="text-align: right;">${h.qty}</td>
          <td style="text-align: right; font-weight: bold;">${h.balance}</td>
          <td>${h.remark || "-"}</td>
          <td>${h.user || "Staf"}</td>
        </tr>
      `;
    });

    printWindow.document.write(`
      <html>
      <head>
        <title>Kad Stok - ${prod.name}</title>
        <style>
          body { font-family: 'Inter', system-ui, sans-serif; padding: 30px; color: #1e293b; }
          .header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #e2e8f0; padding-bottom: 15px; margin-bottom: 20px; }
          .header h1 { margin: 0; font-size: 24px; color: #1e293b; }
          .header p { margin: 4px 0 0; color: #64748b; font-size: 14px; }
          .info-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; margin-bottom: 25px; }
          .info-card { background: #f8fafc; border: 1px solid #e2e8f0; padding: 12px; border-radius: 8px; }
