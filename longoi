function drawQR(canvas, text, size = 180) {
  if (!canvas) return;
  const ctx = canvas.getContext("2d");
  canvas.width = size; canvas.height = size;
  const seed = text.split("").reduce((a, c) => a + c.charCodeAt(0), 0);
  const rand = (i) => ((seed * 9301 + i * 49297) % 233280) / 233280;
  ctx.fillStyle = "#fff"; ctx.fillRect(0, 0, size, size);
  const cols = 21, cell = size / cols;
  const drawFinder = (ox, oy) => {
    ctx.fillStyle = "#1e293b"; ctx.fillRect(ox * cell, oy * cell, 7 * cell, 7 * cell);
    ctx.fillStyle = "#fff"; ctx.fillRect((ox + 1) * cell, (oy + 1) * cell, 5 * cell, 5 * cell);
    ctx.fillStyle = "#1e293b"; ctx.fillRect((ox + 2) * cell, (oy + 2) * cell, 3 * cell, 3 * cell);
  };
  drawFinder(0, 0); drawFinder(14, 0); drawFinder(0, 14);
  for (let r = 0; r < cols; r++) for (let c = 0; c < cols; c++) {
    const inF = (r < 8 && c < 8) || (r < 8 && c >= 13) || (r >= 13 && c < 8);
    if (!inF && rand(r * cols + c) > 0.45) {
      ctx.fillStyle = "#1e293b";
      ctx.fillRect(c * cell, r * cell, cell - 0.5, cell - 0.5);
    }
  }
  ctx.fillStyle = "rgba(255,255,255,0.92)"; ctx.fillRect(8 * cell, 8 * cell, 5 * cell, 5 * cell);
  ctx.fillStyle = "#6366f1"; ctx.font = `bold ${cell * 0.85}px monospace`;
  ctx.textAlign = "center"; ctx.textBaseline = "middle";
  ctx.fillText(text.slice(0, 6), size / 2, size / 2);
}

function MiniQRCode({ text, size = 100 }) {
  const canvasRef = useRef(null);
  useEffect(() => {
    if (canvasRef.current) {
      drawQR(canvasRef.current, text, size);
    }
  }, [text, size]);
  return <canvas ref={canvasRef} style={{ borderRadius: 8, border: "1px solid #e2e8f0", width: size, height: size }} />;
}

